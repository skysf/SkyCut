{
  "name": "skycut-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate.mjs && vite --host 127.0.0.1",
    "build": "node scripts/generate.mjs && vite build",
    "build:scene-media": "node scripts/build-scene-media.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "build:social": "python3 scripts/build-social-images.py",
    "check:seo": "node scripts/check-seo.mjs",
    "build:favicons": "node scripts/build-favicons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "gsap": "3.15.1",
    "three": "0.187.0",
    "vite": "8.3.5"
  }
}
